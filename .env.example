# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the site (used for canonical URLs, sitemap, OpenGraph).
# In development this can be http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact email shown on the contact page (defaults to the project inbox in code).
NEXT_PUBLIC_CONTACT_EMAIL=fantasyfalcoon91@gmail.com

# --- Analytics (privacy-friendly, cookieless). Leave blank to disable. ---
# Your verified site domain in Plausible (or a compatible script). When set, a
# consent banner appears and analytics loads only after the visitor accepts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: custom/self-hosted analytics script URL (defaults to Plausible cloud).
NEXT_PUBLIC_PLAUSIBLE_SRC=
