# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the site (used for canonical URLs, sitemap, OpenGraph).
# In development this can be http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Email shown on the contact page (used as the mailto fallback when no webhook is set).
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example

# --- Analytics (privacy-friendly, cookieless). Leave blank to disable. ---
# Your verified site domain in Plausible (or a compatible script). When set, a
# consent banner appears and analytics loads only after the visitor accepts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: custom/self-hosted analytics script URL (defaults to Plausible cloud).
NEXT_PUBLIC_PLAUSIBLE_SRC=

# --- Cloudflare Turnstile (bot protection for forms). Both needed to enforce. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contact / waitlist delivery webhook (Discord/Slack/Zapier/n8n, all free). ---
# If unset, the contact form falls back to opening the visitor's email client.
CONTACT_WEBHOOK_URL=
