# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the site (used for canonical URLs, sitemap, OpenGraph).
# In development this can be http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Email shown on the contact page (the contact form opens a pre-filled mail to it).
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example
